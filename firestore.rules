rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identidad ----------
    function signedIn() { return request.auth != null && request.auth.token.email is string; }
    function email() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function isSuper() { return signedIn() && verified() && email() == 'luis@llevatelo.com.ve'; }
    function isAdmin() { return isSuper() || (signedIn() && verified() && exists(/databases/$(database)/documents/admins/$(email()))); }
    function dealerDoc() { return get(/databases/$(database)/documents/dealers/$(request.auth.uid)); }
    function isApproved() {
      return signedIn() && exists(/databases/$(database)/documents/dealers/$(request.auth.uid)) && dealerDoc().data.estado == 'aprobado';
    }

    // ---------- validaciones ----------
    function str(v, max) { return v is string && v.size() <= max; }
    function req(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function money(v) { return v is number && v >= 0 && v < 10000000; }
    function onlyKeys(d, keys) { return d.keys().hasOnly(keys); }
    function estadosProp() { return ['enviada', 'en_evaluacion', 'aprobada', 'rechazada', 'desistida']; }
    function validHistEntry(h) { return h is map && h.keys().hasAll(['estado', 'fecha', 'por']) && h.estado in estadosProp() && str(h.fecha, 40) && str(h.por, 200) && (!('nota' in h) || str(h.nota, 500)); }

    // ---------- administradores ----------
    match /admins/{adminEmail} {
      allow read: if signedIn() && (isAdmin() || adminEmail == email());
      allow create: if isAdmin() && adminEmail.matches('^[^@\\s/]+@[^@\\s/]+\\.[^@\\s/]+$') && adminEmail == adminEmail.lower()
        && onlyKeys(request.resource.data, ['agregadoPor', 'creado'])
        && request.resource.data.agregadoPor == request.auth.token.email && request.resource.data.creado == request.time;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // ---------- concesionarios ----------
    match /dealers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && onlyKeys(request.resource.data, ['razonSocial', 'nombre', 'direccion', 'red', 'contacto', 'telefono', 'email', 'estado', 'creado', 'nota'])
        && req(request.resource.data.razonSocial, 150) && req(request.resource.data.nombre, 100) && req(request.resource.data.direccion, 300)
        && req(request.resource.data.red, 200) && req(request.resource.data.contacto, 100) && req(request.resource.data.telefono, 40)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.estado == 'pendiente' && request.resource.data.nota == '' && request.resource.data.creado == request.time;
      // Solo Llévatelo cambia el estado de un concesionario
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoPor', 'revisadoEn', 'nota'])
        && request.resource.data.estado in ['pendiente', 'aprobado', 'rechazado', 'suspendido']
        && request.resource.data.revisadoPor == request.auth.token.email && request.resource.data.revisadoEn == request.time;
      allow delete: if isAdmin();
    }

    // ---------- propuestas de financiamiento ----------
    match /propuestas/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (isApproved() || isAdmin())
        && onlyKeys(request.resource.data, ['uid', 'email', 'concesionario', 'asesor', 'cliente', 'vehiculo', 'cond', 'km', 'comentario', 'precio', 'disponible', 'inicial', 'financiado', 'plazo', 'cuota', 'corte', 'estado', 'notaLlevatelo', 'historial', 'creado', 'actualizado'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email
        && (isAdmin() || request.resource.data.concesionario == dealerDoc().data.nombre)
        && req(request.resource.data.concesionario, 100) && str(request.resource.data.asesor, 100)
        && request.resource.data.cliente is map && onlyKeys(request.resource.data.cliente, ['nombre', 'cedula', 'telefono'])
        && req(request.resource.data.cliente.nombre, 120) && req(request.resource.data.cliente.cedula, 30) && req(request.resource.data.cliente.telefono, 40)
        && req(request.resource.data.vehiculo, 150) && request.resource.data.cond in ['usado', 'nuevo'] && str(request.resource.data.km, 30) && str(request.resource.data.comentario, 1000)
        && money(request.resource.data.precio) && request.resource.data.precio > 0 && money(request.resource.data.disponible) && money(request.resource.data.inicial)
        && money(request.resource.data.financiado) && money(request.resource.data.cuota)
        && request.resource.data.plazo is int && request.resource.data.plazo >= 1 && request.resource.data.plazo <= 48
        && str(request.resource.data.corte, 10) && request.resource.data.estado == 'enviada' && request.resource.data.notaLlevatelo == ''
        && request.resource.data.historial is list && request.resource.data.historial.size() == 1 && validHistEntry(request.resource.data.historial[0])
        && request.resource.data.creado == request.time && request.resource.data.actualizado == request.time;
      // Llévatelo cambia estado y nota
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'notaLlevatelo', 'actualizado', 'historial'])
          && request.resource.data.estado in estadosProp() && str(request.resource.data.notaLlevatelo, 500)
          && request.resource.data.historial is list && request.resource.data.historial.size() == resource.data.historial.size() + 1
          && validHistEntry(request.resource.data.historial[request.resource.data.historial.size() - 1])
          && request.resource.data.actualizado == request.time)
        // El concesionario solo puede marcar su propuesta como desistida
        || (isApproved() && resource.data.uid == request.auth.uid && resource.data.estado in ['enviada', 'en_evaluacion']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizado', 'historial'])
          && request.resource.data.estado == 'desistida'
          && request.resource.data.historial is list && request.resource.data.historial.size() == resource.data.historial.size() + 1
          && request.resource.data.actualizado == request.time);
      allow delete: if isAdmin();
    }

    // Todo lo demás, cerrado
    match /{document=**} { allow read, write: if false; }
  }
}
